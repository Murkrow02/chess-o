# Copy to .env and adjust. .env is git-ignored.

# OpenAI-compatible endpoint of the coach LLM (Ollama exposes one at /v1)
LLM_BASE_URL=http://10.0.0.10:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Leave empty for Ollama; set when your endpoint needs a key
LLM_API_KEY=
# "none" disables thinking on hybrid models such as Qwen3; leave empty if your server rejects it
LLM_REASONING_EFFORT=none

# Embeddings for the knowledge base (Ollama native API)
EMBED_BASE_URL=http://10.0.0.10:11434
EMBED_MODEL=bge-m3
# Build the knowledge base in the background on first start (about 10 minutes on a small GPU)
RAG_AUTO_INGEST=true

# Engine
ENGINE_WORKERS=0          # 0 = CPU cores - 1
ENGINE_DEPTH=14           # full-game pass
ENGINE_DEEP_DEPTH=20      # key moments
ENGINE_MULTIPV=3
ENGINE_HASH_MB=64

# Host port for the web UI
CHESSO_PORT=8080
